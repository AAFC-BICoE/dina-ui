    "next": "*",
    "react": "*",
    "react-dom": "*",
    "react-dropzone-uploader": "*",
    "react-switch": "*",
    "react-tabs": "*",
    "react-zoom-pan-pinch": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@faker-js/faker": "*",
